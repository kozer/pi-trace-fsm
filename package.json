{
  "name": "pi-trace-fsm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Passive per-project activity FSM telemetry for pi",
  "license": "MIT",
  "keywords": ["pi", "pi-package", "pi-extension", "fsm", "agent-traces"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "fsm.ts",
    "store.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  }
}
